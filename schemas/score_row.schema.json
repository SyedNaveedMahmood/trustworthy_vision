{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed frozen VLM choice score",
  "type": "object",
  "required": ["run_key", "status", "model_id", "model_revision", "processor_revision", "image_sha256", "prompt_sha256", "label_ids", "choice_logits", "probabilities", "prediction", "input_tokens", "wall_seconds", "cache_hit", "retry_count", "exception"],
  "properties": {
    "run_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "OK"},
    "model_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "processor_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "label_ids": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
    "choice_logits": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "probabilities": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
    "prediction": {"enum": ["A", "B", "C", "D"]},
    "input_tokens": {"type": "integer", "minimum": 1},
    "wall_seconds": {"type": "number", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "cache_hit": {"type": "boolean"},
    "exception": {"type": "null"}
  }
}
